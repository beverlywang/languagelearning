# No API key required. This app uses MyMemory, which is free and needs no signup.
#
# Optional: setting an email raises the free daily quota from about 5,000 words
# to about 50,000. It is sent as an identifier only and is not verified.
# MYMEMORY_EMAIL=you@example.com

# Optional: target language. Defaults to English.
# TARGET_LANG=en
